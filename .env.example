# Copy to .env.local. Local Supabase in this repo uses 563xx ports
# (API 56321, DB 56322, Studio 56323, Mailpit 56324) — see supabase status.
XAI_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local: postgresql://postgres:postgres@127.0.0.1:56322/postgres
# Hosted: use the transaction pooler URL for Next.js.
DATABASE_URL=
# Tests + scripts/import-sqlite.ts only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
